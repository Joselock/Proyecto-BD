<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXPasswordField?>
<?import com.jfoenix.controls.JFXTextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="490.0" prefWidth="758.0" style="-fx-background-color: #2d7a2d;" stylesheets="@registro.css" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.gestorui.controllers.Registro.RegistroCredencialesController">
   <children>
       <ImageView fitHeight="521.0" fitWidth="351.0" layoutX="410.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../images/HGV%20Medical%20Services%20for%20Professional%20Drivers.jpeg" />
         </image></ImageView>
       
      <AnchorPane layoutX="211.0" layoutY="59.0" opacity="0.94" prefHeight="417.0" prefWidth="336.0" style="-fx-background-color: #ffffff;" styleClass="panel-registro" stylesheets="@registro.css">
         <children>
            <Label layoutX="114.0" layoutY="29.0" text="Credenciales">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            
            <!-- Campo: Nombre de usuario -->
            <JFXTextField fx:id="txtNombreUsuario" focusColor="#0c0a75" layoutX="47.0" layoutY="77.0" prefHeight="24.0" prefWidth="251.0" promptText="Nombre de usuario" stylesheets="@../styles/registro.css" unFocusColor="BLACK" />
            
            <!-- Campo: Gmail -->
            <JFXTextField fx:id="txtGmail" focusColor="#0c0a75" layoutX="47.0" layoutY="138.0" prefHeight="24.0" prefWidth="251.0" promptText="Gmail" unFocusColor="BLACK" />
            
            <!-- Campo: Contraseña (oculto) -->
            <JFXPasswordField fx:id="txtPassword" focusColor="#0c0a75" layoutX="47.0" layoutY="197.0" prefHeight="24.0" prefWidth="240.0" promptText="Ingrese la contraseña" unFocusColor="BLACK" />
            
            <!-- Campo: Contraseña visible (para mostrar cuando se abre el ojo) -->
            <JFXTextField fx:id="txtPasswordVisible" focusColor="#0c0a75" layoutX="47.0" layoutY="197.0" managed="false" prefHeight="24.0" prefWidth="240.0" promptText="Ingrese la contraseña" unFocusColor="#9899a1" visible="false" />
            
            <!-- Botón de ojo para mostrar/ocultar contraseña 1 -->
            <Label fx:id="btnTogglePassword1" layoutX="291.0" layoutY="197.0" onMouseClicked="#togglePasswordVisibility1" prefHeight="24.0" prefWidth="22.0" style="-fx-cursor: hand;">
                <graphic>
                    <ImageView fx:id="eyeIcon1" fitHeight="16" fitWidth="16" preserveRatio="true">
                        <Image url="@/com/mycompany/gestorui/images/eye-closed.png" />
                    </ImageView>
                </graphic>
            </Label>
            
            <!-- Campo: Confirmar contraseña (oculto) -->
            <JFXPasswordField fx:id="txtConfirmPassword" focusColor="#0c0a75" layoutX="47.0" layoutY="250.0" prefHeight="24.0" prefWidth="240.0" promptText="Confirme la contraseña" unFocusColor="BLACK" />
            
            <!-- Campo: Confirmar contraseña visible -->
            <JFXTextField fx:id="txtConfirmPasswordVisible" focusColor="#0c0a75" layoutX="47.0" layoutY="250.0" managed="false" prefHeight="24.0" prefWidth="240.0" promptText="Confirme la contraseña" unFocusColor="#9899a1" visible="false" />
            
            <!-- Botón de ojo para mostrar/ocultar contraseña 2 -->
            <Label fx:id="btnTogglePassword2" layoutX="291.0" layoutY="250.0" onMouseClicked="#togglePasswordVisibility2" prefHeight="24.0" prefWidth="22.0" style="-fx-cursor: hand;">
                <graphic>
                    <ImageView fx:id="eyeIcon2" fitHeight="16" fitWidth="16" preserveRatio="true">
                        <Image url="@/com/mycompany/gestorui/images/eye-closed.png" />
                    </ImageView>
                </graphic>
            </Label>
            
            <!-- Botón Registrarse -->
            <JFXButton fx:id="btnRegistrar" alignment="CENTER" layoutX="72.0" layoutY="296.0" onAction="#handleRegistrar" prefHeight="36.0" prefWidth="192.0" styleClass="register-button" text="Registrarse" />
            
            <!-- Botón Cancelar -->
            <JFXButton fx:id="btnCancelar" layoutX="72.0" layoutY="344.0" onAction="#handleCancelar" prefHeight="36.0" prefWidth="192.0" styleClass="cancel-button" stylesheets="@../styles/registro.css" text="Cancelar" />
         </children>
      </AnchorPane>
      
      <Label fx:id="cerrar" layoutX="20.0" layoutY="14.0" onMouseClicked="#handleClose" style="-fx-cursor: hand;" text="X" textFill="#bfbebe">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label fx:id="minimizar" layoutX="40.0" layoutY="14.0" onMouseClicked="#handleMinimize" style="-fx-cursor: hand;" text="—" textFill="#bfbebe">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
