<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.gestorui.controllers.Reporte.TopHospitalesController">
   <children>
      <VBox layoutX="20.0" layoutY="60.0" prefHeight="620.0" prefWidth="960.0" spacing="15.0">
         <children>
            <Label text="Top 5 hospitales con más de 100 pacientes">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Label fx:id="lblInfo">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            
            <ScrollPane fitToWidth="true" prefHeight="500.0" prefWidth="960.0">
               <content>
                  <TableView fx:id="tablaHospitales" prefHeight="500.0" prefWidth="940.0">
                     <columns>
                        <TableColumn fx:id="colPosicion" prefWidth="100.0" text="Posición" />
                        <TableColumn fx:id="colNombre" prefWidth="600.0" text="Hospital" />
                        <TableColumn fx:id="colPacientes" prefWidth="200.0" text="Cantidad de Pacientes" />
                     </columns>
                  </TableView>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
