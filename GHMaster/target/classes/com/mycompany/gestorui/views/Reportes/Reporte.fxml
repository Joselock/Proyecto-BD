<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.gestorui.controllers.Reporte.ReporteController">
   <children>
      <StackPane fx:id="contentPane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <!-- Menú Principal de Reportes -->
            <AnchorPane fx:id="menuPane" prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f5f5f5;">
               <children>
                  <Label alignment="CENTER" layoutX="400.0" layoutY="30.0" prefHeight="58.0" prefWidth="200.0" text="Reportes">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
                  
                  <!-- Primera fila -->
                  <HBox layoutX="50.0" layoutY="120.0" prefHeight="130.0" prefWidth="900.0" spacing="20.0">
                     <children>
                        <!-- Listado de Pacientes -->
                        <VBox alignment="CENTER" onMouseClicked="#handleListadoPacientes" prefHeight="120.0" prefWidth="200.0" spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-cursor: hand;" styleClass="metric-card" stylesheets="@style/reportes.css">
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                           <children>
                              <Label style="-fx-font-size: 32px;">📋</Label>
                              <Label alignment="CENTER" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-alignment: center;" text="Listado de pacientes" wrapText="true" />
                           </children>
                        </VBox>
                        
                        <!-- Listado de Médicos -->
                        <VBox alignment="CENTER" onMouseClicked="#handleListadoMedicos" prefHeight="120.0" prefWidth="200.0" spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-cursor: hand;" styleClass="metric-card" stylesheets="@style/reportes.css">
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                           <children>
                              <Label style="-fx-font-size: 32px;">👨‍⚕️</Label>
                              <Label alignment="CENTER" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-alignment: center;" text="Listado de médicos" wrapText="true" />
                           </children>
                        </VBox>
                        
                        <!-- Resumen por Hospitales -->
                        <VBox alignment="CENTER" onMouseClicked="#handleResumenHospital" prefHeight="120.0" prefWidth="200.0" spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-cursor: hand;" styleClass="metric-card" stylesheets="@style/reportes.css">
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                           <children>
                              <Label style="-fx-font-size: 32px;">🏥</Label>
                              <Label alignment="CENTER" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-alignment: center;" text="Resumen por hospitales" wrapText="true" />
                           </children>
                        </VBox>
                        
                        <!-- Top 5 Hospitales -->
                        <VBox alignment="CENTER" onMouseClicked="#handleTop" prefHeight="120.0" prefWidth="200.0" spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-cursor: hand;" styleClass="metric-card" stylesheets="@style/reportes.css">
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                           <children>
                              <Label style="-fx-font-size: 32px;">🏆</Label>
                              <Label alignment="CENTER" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-alignment: center;" text="Top 5 hospitales" wrapText="true" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  
                  <!-- Segunda fila -->
                  <HBox layoutX="50.0" layoutY="270.0" prefHeight="130.0" prefWidth="900.0" spacing="20.0">
                     <children>
                        <!-- Informe durante consultas -->
                        <VBox alignment="CENTER" onMouseClicked="#handleInformesConsultas" prefHeight="120.0" prefWidth="200.0" spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-cursor: hand;" styleClass="metric-card" stylesheets="@style/reportes.css">
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                           <children>
                              <Label style="-fx-font-size: 32px;">📊</Label>
                              <Label alignment="CENTER" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-alignment: center;" text="Informe durante consultas" wrapText="true" />
                           </children>
                        </VBox>
                        
                        <!-- Pacientes no atendidos -->
                        <VBox alignment="CENTER" onMouseClicked="#handleNOAtendidos" prefHeight="120.0" prefWidth="200.0" spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-cursor: hand;" styleClass="metric-card" stylesheets="@style/reportes.css">
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                           <children>
                              <Label style="-fx-font-size: 32px;">❌</Label>
                              <Label alignment="CENTER" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-alignment: center;" text="Pacientes no atendidos" wrapText="true" />
                           </children>
                        </VBox>
                        
                        <!-- Resumen del proceso -->
                        <VBox alignment="CENTER" onMouseClicked="#handleResumenProceso" prefHeight="120.0" prefWidth="200.0" spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-cursor: hand;" styleClass="metric-card" stylesheets="@style/reportes.css">
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                           <children>
                              <Label style="-fx-font-size: 32px;">📈</Label>
                              <Label alignment="CENTER" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-alignment: center;" text="Resumen del proceso" wrapText="true" />
                           </children>
                        </VBox>
                        
                        <!-- Revisar turnos -->
                        <VBox alignment="CENTER" onMouseClicked="#handleRevisarTurno" prefHeight="120.0" prefWidth="200.0" spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-cursor: hand;" styleClass="metric-card" stylesheets="@style/reportes.css">
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                           <children>
                              <Label style="-fx-font-size: 32px;">🔄</Label>
                              <Label alignment="CENTER" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-alignment: center;" text="Revisar turnos" wrapText="true" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  
                  <!-- Tercera fila -->
                  <HBox layoutX="50.0" layoutY="420.0" prefHeight="130.0" prefWidth="900.0" spacing="20.0">
                     <children>
                        <!-- Consultas exitosas -->
                        <VBox alignment="CENTER" onMouseClicked="#handleConsultasExitosas" prefHeight="120.0" prefWidth="200.0" spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-cursor: hand;" styleClass="metric-card" stylesheets="@style/reportes.css">
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                           <children>
                              <Label style="-fx-font-size: 32px;">✅</Label>
                              <Label alignment="CENTER" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-alignment: center;" text="Consultas exitosas" wrapText="true" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
            
            <!-- Vistas de Reportes (se cargan dinámicamente) -->
         </children>
      </StackPane>
      
      <!-- Botón de Volver (visible solo en las vistas de reportes) -->
      <Button fx:id="btnBack" layoutX="20.0" layoutY="20.0" mnemonicParsing="false" onAction="#handleBack" prefHeight="32.0" prefWidth="100.0" style="-fx-background-color: transparent; -fx-text-fill: #2d7a2d; -fx-font-size: 14px; -fx-font-weight: bold;" text="← Volver" visible="false" />
      
      <!-- Título del Reporte Actual -->
      <Label fx:id="lblTituloReporte" layoutX="130.0" layoutY="22.0" prefHeight="30.0" prefWidth="700.0" text="" textFill="#2c3e50" visible="false">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      
      <!-- Controles de ventana -->
      <Label fx:id="minimizar" layoutX="930.0" layoutY="25.0" onMouseClicked="#handleMinimize" style="-fx-cursor: hand;" text="—">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <Label fx:id="cerrar" layoutX="960.0" layoutY="25.0" onMouseClicked="#handleClose" style="-fx-cursor: hand;" text="X">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
